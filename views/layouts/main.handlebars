<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#0a0a0f">
	<title>Queued Up — Add songs to your friends' Spotify queue</title>
	<meta name="description" content="Queued Up lets you add songs to your friend's Spotify queue in real time. Connect with friends, search Spotify, and DJ together.">
	<link rel="icon" href="/static/QueuedUP.png" type="image/png">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/css/style.css">
</head>
<body>
	{{> navbar}}

	<main class="page">
		{{{body}}}
	</main>

	<footer class="footer">
		<div class="container footer__row">
			<span>© Queued Up · Spotify is a trademark of Spotify AB.</span>
			<span>Built with Express · Upstash Redis · Vercel</span>
		</div>
	</footer>

	<div class="toast-host" id="toast-host" aria-live="polite" aria-atomic="true"></div>

	<script src="/js/toast.js"></script>
	<script src="/js/nav.js"></script>
	{{#if user}}
		<script src="/js/friend-search.js"></script>
		<script src="/js/friend-actions.js"></script>
		<script src="/js/spotify-search.js"></script>
	{{/if}}
</body>
</html>
