<header class="nav">
	<div class="container nav__inner">
		<a class="brand" href="/">
			<span class="brand__mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4 18V6l12-2v12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
					<circle cx="6" cy="18" r="2.4" fill="currentColor"/>
					<circle cx="16" cy="16" r="2.4" fill="currentColor"/>
				</svg>
			</span>
			<span>Queued Up</span>
		</a>

		<button type="button" class="nav__toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
			<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
			</svg>
		</button>

		<nav class="nav__links" id="nav-links">
			{{#if user}}
				<a href="/friends" class="nav__link">Friends</a>
				<a href="/search" class="nav__link">Discover</a>
				<a href="/posts/new" class="nav__link">Feedback</a>
				<a href="/logout" class="nav__link">Log out</a>
			{{else}}
				<a href="/auth/spotify" class="nav__link">Log in with Spotify</a>
			{{/if}}
		</nav>
	</div>
</header>
