<section class="container section fade-in">
	<div class="section__head">
		<div>
			<h2 class="section__title">Spotify search</h2>
			<p class="section__lead">Run a quick query against the Spotify catalog.</p>
		</div>
	</div>

	<form action="/" method="post" class="card" style="max-width: 640px;">
		<div class="field">
			<label class="field__label" for="param_type">Type</label>
			<input type="text" class="input" name="param_type" id="param_type" placeholder="track">
		</div>

		<div class="field">
			<label class="field__label" for="param_query">Query</label>
			<input type="text" class="input" name="param_query" id="param_query" placeholder="Swing Life Away">
		</div>

		<button type="submit" class="btn btn--primary">Search</button>
	</form>

	{{#if results.length}}
		<div class="card mt-5" style="overflow: hidden; padding: 0;">
			<table style="width: 100%; border-collapse: collapse;">
				<thead>
					<tr style="text-align: left; background: var(--surface); color: var(--text-muted); font-size: 0.85rem;">
						<th style="padding: 14px 18px;">Artist</th>
						<th style="padding: 14px 18px;">Song</th>
						<th style="padding: 14px 18px;">Preview</th>
						<th style="padding: 14px 18px;">Album</th>
					</tr>
				</thead>
				<tbody>
					{{#each results}}
						<tr style="border-top: 1px solid var(--surface-stroke);">
							<td style="padding: 14px 18px;">{{artist}}</td>
							<td style="padding: 14px 18px; color: var(--text);">{{song}}</td>
							<td style="padding: 14px 18px;"><a href="{{preview}}" rel="noopener" target="_blank">Listen</a></td>
							<td style="padding: 14px 18px; color: var(--text-muted);">{{album}}</td>
						</tr>
					{{/each}}
				</tbody>
			</table>
		</div>
	{{/if}}
</section>
