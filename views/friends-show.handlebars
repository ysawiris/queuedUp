<section class="container section fade-in">
	<a href="/friends" class="muted" style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px; font-size: 0.9rem;">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
		Back to friends
	</a>

	<header class="profile-head">
		<span class="avatar avatar--xl avatar--ring">
			{{#if frienduser.photo}}
				<img src="{{frienduser.photo}}" alt="{{frienduser.username}}">
			{{/if}}
		</span>
		<div>
			<p class="muted" style="font-size: 0.85rem; margin: 0 0 6px;">Sending to</p>
			<h1 class="profile-head__name">{{frienduser.username}}</h1>
			<p class="profile-head__sub">Find a song below — it'll land in their queue.</p>
		</div>
	</header>

	<input type="hidden" id="friend_token" value="{{frienduser.spotifyToken}}">
	<input type="hidden" id="user_token1" value="{{user.spotifyToken}}">

	<div class="search-bar">
		<svg class="search-bar__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M9 18V5l12-2v13"/>
			<circle cx="6" cy="18" r="3"/>
			<circle cx="18" cy="16" r="3"/>
		</svg>
		<input type="text" id="song" class="input" placeholder="Search Spotify — song or artist" autocomplete="off">
	</div>

	<div id="song-results" class="song-list mt-5" aria-live="polite"></div>

	<div id="song-empty" class="empty">
		<div class="empty__icon">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
		</div>
		<h3>What are we adding?</h3>
		<p class="mt-2">Type a track or artist name to search Spotify.</p>
	</div>
</section>
