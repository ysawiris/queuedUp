# Copy this file to .env and fill in real values.

# A long random string. Generate with: openssl rand -hex 64
SESSION_SECRET=

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_URL=http://localhost:8080/callback

# Mongo
MONGODB_URI=mongodb://localhost:27017/queue-db

# Optional
PORT=8080
NODE_ENV=development
